[Unit]
Description=Private movie identity observation (Landlock shadow mode)
Requires=identity-triage.socket
After=identity-triage.socket
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/movie-identity-triage
# Four collector modules only. A clean environment, no acquisition credentials.
ExecStart=/usr/bin/env -i HOME=%h PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -I -B -u identity_triage_service.py --config %h/.config/movie-identity-triage/config.json --state %h/.local/state/movie-identity-triage
UMask=0077
StandardInput=null
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
# The sole listener comes from the socket unit. No new Unix/TCP/UDP socket or
# external connection. Also deny ABI6 filesystem-metadata and process/FD bypasses.
SystemCallFilter=~socket socketpair connect @chown chmod fchmod fchmodat fchmodat2 utime utimes futimesat utimensat setxattr lsetxattr fsetxattr removexattr lremovexattr fremovexattr ptrace process_vm_readv process_vm_writev pidfd_getfd io_uring_setup io_uring_enter io_uring_register
MemoryMax=128M
TasksMax=20
Restart=on-failure
RestartSec=30

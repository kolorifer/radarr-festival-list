[Unit]
Description=Private movie identity observation (shadow mode only)

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/movie-identity-triage
# Install ONLY identity_triage_{service,intake,store}.py here; stdlib only.
ExecStart=/usr/bin/env -i HOME=%h PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -u identity_triage_service.py --config %h/.config/movie-identity-triage/config.json --state %h/.local/state/movie-identity-triage
UMask=0077
PrivateUsers=yes
ProtectHome=tmpfs
ProtectSystem=strict
BindReadOnlyPaths=%h/.local/lib/movie-identity-triage %h/.config/movie-identity-triage
BindPaths=%h/.local/state/movie-identity-triage
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=128M
TasksMax=20
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
